# =============================================================================
# EduPredict AI - Environment Configuration Example
# Copy this file to .env (or configure in Vercel Project Settings)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google OAuth 2.0 / Google Identity Services (GIS)
# -----------------------------------------------------------------------------
# Obtain from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials -> Create Credentials -> OAuth client ID -> Web application
#
# Authorized JavaScript origins (Required for Google Identity Services popup & One Tap):
#   - Local development: http://localhost:3000
#   - AI Studio Preview: https://ais-pre-4zj5arvazaplp5zyptn5ta-711679809684.asia-northeast1.run.app
#   - Vercel Deployment: https://your-app-name.vercel.app
#
# Authorized redirect URIs (Only needed if using full-browser OAuth redirect fallback):
#   - http://localhost:3000
#   - http://localhost:3000/login
#   - https://your-app-name.vercel.app
#   - https://your-app-name.vercel.app/login
#
# Client environment variable (Vite client build):
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server-side verification variable (Express / Vercel Serverless Function):
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 2. Server Session Security
# -----------------------------------------------------------------------------
# Random string used to sign session cookies and tokens (minimum 32 characters)
SESSION_SECRET=your-random-32-char-session-secret-string

# -----------------------------------------------------------------------------
# 3. Google Gemini AI API Configuration
# -----------------------------------------------------------------------------
# API key for academic recommendations, intelligent study planner, and AI tutor
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# =============================================================================
# EduPredict AI — Environment Configuration Template (.env.example)
# Copy this file to .env for local development, or set these in Vercel Dashboard
# =============================================================================

# -----------------------------------------------------------------------------
# Google Identity Services / Google Sign-In OAuth
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Web Application Type:
#   - Authorized JavaScript origins: http://localhost:3000, https://<your-app>.vercel.app
#   - Authorized redirect URIs: http://localhost:3000, https://<your-app>.vercel.app
# -----------------------------------------------------------------------------
# Client-side Vite environment variable (exposed to browser at build/dev time):
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server-side environment variable (read by Express / Vercel Serverless Function for token verification):
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Gemini AI Configuration
# -----------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Session & Authentication Secret
# -----------------------------------------------------------------------------
SESSION_SECRET=your-random-32-character-session-secret-key-here

# -----------------------------------------------------------------------------
# Twilio SMS OTP Verification (Optional — phone authentication falls back to simulated OTP in dev)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
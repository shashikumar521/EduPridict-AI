# Server Configuration
PORT=3000
NODE_ENV=development

# Google OAuth 2.0 Client ID (Required for Google Sign-In)
# Obtain from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials > OAuth client ID > Web application
# 3. Add Authorized JavaScript origins: http://localhost:3000 and your production app domain
# 4. Copy the Client ID (looks like xxxxx.apps.googleusercontent.com) and paste below:
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Google Gemini API (Optional - required for live AI Academic Counselor responses)
# If omitted, intelligent offline counselor knowledge base fallback is used automatically.
GEMINI_API_KEY=
